# ==============================================================================
# Vizare Application Environment Configuration Template
# Copy this file to '.env' in the project root and fill in the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (safe for mobile client distribution)
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Supabase Service Role Key (CONFIDENTIAL: Backend API Router only, NEVER embed in mobile app binary)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. API Router & Serverless Configuration
# ------------------------------------------------------------------------------
# Base API endpoint for Vercel/Node.js compatibility router
# Local development: http://localhost:3000/api
# Production: https://vizare.vercel.app/api
API_BASE_URL=https://vizare.vercel.app/api

# Comma-separated list of allowed CORS origins for the API Router
ALLOWED_ORIGINS=https://vizare.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Google Maps & Geolocation
# ------------------------------------------------------------------------------
# Google Maps Platform API Key (used for property map viewports & place autocomplete)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ------------------------------------------------------------------------------
# 4. Google OAuth Authentication
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web / Server Client ID for Google Sign-In
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Email & Customer Support (EmailJS)
# ------------------------------------------------------------------------------
# EmailJS service parameters for contact support ticketing
EMAILJS_SERVICE_ID=service_vizare_support
EMAILJS_TEMPLATE_ID=template_contact_form
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
