# ==============================================================================
# Vizare Application Environment Configuration Template
# Copy this file to '.env' in the project root and fill in the values.
# In production, only API_BASE_URL is required; all keys are managed in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Router & Serverless Gateway (Required)
# ------------------------------------------------------------------------------
# Base API endpoint for Vercel Serverless Functions
# Production: https://vizare-web.vercel.app/api
# Local development: http://localhost:3000/api
API_BASE_URL=https://vizare-web.vercel.app/api

# ------------------------------------------------------------------------------
# 2. Optional Local Development Overrides
# (If not specified, the app dynamically retrieves public client configs from Vercel)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# SUPABASE_SECRET_KEY=sb_secret_your_key_here (Vercel serverless environment only)
# GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com


# ------------------------------------------------------------------------------
# 3. Google Maps & Geolocation
# ------------------------------------------------------------------------------
# Google Maps Platform API Key (used for property map viewports & place autocomplete)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ------------------------------------------------------------------------------
# 4. Google OAuth Authentication
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web / Server Client ID for Google Sign-In
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Email & Customer Support (EmailJS)
# ------------------------------------------------------------------------------
# EmailJS service parameters for contact support ticketing
EMAILJS_SERVICE_ID=service_vizare_support
EMAILJS_TEMPLATE_ID=template_contact_form
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

